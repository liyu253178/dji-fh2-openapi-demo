{
  "name": "duav-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DUAV 后端 BFF：大疆司空 2 OpenAPI 鉴权转发、成果资产、工单闭环",
  "main": "src/index.js",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "test:db": "node scripts/test-db.mjs",
    "test:flow": "node scripts/test-flow.mjs",
    "test:http": "node scripts/verify-http.mjs",
    "test:asset": "node scripts/verify-asset.mjs",
    "assert:asset": "node scripts/assert-asset.mjs",
    "db:reset": "node -e \"import('node:fs').then(fs=>{['data/duav.db','data/duav.db-wal','data/duav.db-shm'].forEach(f=>fs.existsSync(f)&&fs.unlinkSync(f));console.log('数据库已重置')})\"",
    "test:wayline": "node scripts/verify-wayline-kernel.mjs",
    "test:grid": "node scripts/verify-grid-geometry.mjs",
    "test:mail": "node scripts/test-mail.mjs",
    "test:oblique": "node scripts/verify-oblique.mjs",
    "test:wayline-int": "node scripts/verify-wayline-integration.mjs"
  },
  "dependencies": {
    "ali-oss": "^6.21.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fflate": "^0.8.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "sharp": "^0.35.5"
  }
}
